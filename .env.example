# ezBookkeeping API（容器内可用内网地址，如 http://ezbookkeeping:8080）
EZ_BASE_URL=http://127.0.0.1:8080
# 单用户模式使用以下两项；启用 BRIDGE_USERS_FILE 后它们不参与鉴权和 ez 写入。
EZ_API_TOKEN=your_ez_api_token_here

# 中转服务鉴权（本地 curl / 快捷指令均需携带）
BRIDGE_API_TOKEN=your_bridge_token_here
# 多用户模式：先复制 config/users.example.json 为 config/users.json，再取消注释
# BRIDGE_USERS_FILE=/app/config/users.json

# 中转服务专用：截图识图用的 OpenAI 兼容视觉模型（与 ez 服务端 LLM 配置无关）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini

DEFAULT_TIMEZONE=Asia/Shanghai
DEFAULT_CASH_ACCOUNT_NAME=现金账户

# 本机开发可用相对路径；Docker 内用 /app/prompts
PROMPTS_DIR=./prompts
MAX_IMAGE_BYTES=5242880

EZ_REQUEST_TIMEOUT_SECONDS=30
LLM_REQUEST_TIMEOUT_SECONDS=120

# 可选：对账分类路径覆盖（二级）。留空则按 AI adjust_kind 自动匹配：
# cash → 名称含「修改余额」；investment → 名称含「涨跌」
# BALANCE_ADJUST_EXPENSE_CATEGORY_PATH=临时性必要开支 > 修改余额
# BALANCE_ADJUST_INCOME_CATEGORY_PATH=其他收入 > 修改余额
# BALANCE_INVESTMENT_EXPENSE_CATEGORY_PATH=投资损益 > 涨跌
# BALANCE_INVESTMENT_INCOME_CATEGORY_PATH=投资损益 > 涨跌

RATE_LIMIT_PER_MINUTE=10

# ---------- Bark 通知（记账/对账结果 + 相似金额监测）----------
# 未配置则服务仍可用，结果只写 HTTP 调试字段、监测到点跳过
# BARK_PUSH_URL=https://bark.example.com/YOUR_DEVICE_KEY
# DUPLICATE_WATCH_DAILY_TIME=09:00
